SECRET_KEY=change-me-to-a-random-value

# TLS: point to cert/key files (self-signed for local testing, real cert in prod).
# SESSION_COOKIE_SECURE auto-enables when both files exist; override with
# COOKIE_SECURE=true|false to force it.
SSL_CERT=certs/cert.pem
SSL_KEY=certs/key.pem
COOKIE_SECURE=auto

# 4tSuite revocation list: SSO-established sessions are re-checked against it
# on every request (local-login sessions are never checked). Leave unset to
# disable. Token: python -m tools.revocation_tokens issue 4texecutive (in 4tSuite).
# TSUITE_REVOCATIONS_URL=https://host.docker.internal:8400
# TSUITE_REVOCATIONS_TOKEN=
# TSUITE_REVOCATIONS_VERIFY_TLS=false   # only for local self-signed stacks
